<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Suspension_Date_Required_When_Suspended</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Branch_Status__c, "Suspended"),
    ISBLANK(Suspension_Date__c)
)</errorConditionFormula>
    <errorMessage>Suspension Date is required when Branch Status is Suspended.</errorMessage>
    <errorDisplayField>Suspension_Date__c</errorDisplayField>
</ValidationRule>